<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         THEME: PAPER — "paper instrument" (light).
         Brushes + C_* colors ONLY; all shared styles live in Resources.xaml and
         reference these keys via DynamicResource so a runtime dictionary swap
         (MainViewModel.ApplyTheme, merged-dictionary slot 0) restyles live.
         Frozen key set (DESIGN-CONTRACT.md) — every brush key here must exist
         in Graphite.xaml and Nord.xaml too.
         ========================================================================= -->

    <!-- Core colors -->
    <Color x:Key="C_Rail">#FFF2F4F7</Color>
    <Color x:Key="C_Bg">#FFFFFFFF</Color>
    <Color x:Key="C_Panel">#FFF7F8FA</Color>
    <Color x:Key="C_PanelHi">#FFEBEEF3</Color>
    <Color x:Key="C_CardIn">#FFFFFFFF</Color>
    <Color x:Key="C_CardOut">#FFFDF0DA</Color>
    <Color x:Key="C_Line">#FFE3E7ED</Color>
    <Color x:Key="C_LineStrong">#FFCDD4DD</Color>
    <Color x:Key="C_Accent">#FFE8890C</Color>
    <Color x:Key="C_AccentSoft">#FFF5A93B</Color>
    <Color x:Key="C_Ink">#FF231703</Color>
    <Color x:Key="C_GreenOk">#FF18A558</Color>
    <Color x:Key="C_RedBad">#FFE24C4B</Color>
    <Color x:Key="C_CyanInfo">#FF0E8FA3</Color>
    <Color x:Key="C_Fg">#FF111826</Color>
    <Color x:Key="C_FgMid">#FF5D6675</Color>
    <Color x:Key="C_FgLow">#FFA3ABB6</Color>
    <Color x:Key="C_UnreadBadge">#FFE8890C</Color>

    <!-- Frozen brushes -->
    <SolidColorBrush x:Key="RailBg" Color="{StaticResource C_Rail}" />
    <SolidColorBrush x:Key="Bg" Color="{StaticResource C_Bg}" />
    <SolidColorBrush x:Key="PanelBg" Color="{StaticResource C_Panel}" />
    <SolidColorBrush x:Key="PanelHi" Color="{StaticResource C_PanelHi}" />
    <SolidColorBrush x:Key="CardIn" Color="{StaticResource C_CardIn}" />
    <SolidColorBrush x:Key="CardOut" Color="{StaticResource C_CardOut}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource C_Line}" />
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource C_LineStrong}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C_Accent}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource C_AccentSoft}" />
    <SolidColorBrush x:Key="GreenOk" Color="{StaticResource C_GreenOk}" />
    <SolidColorBrush x:Key="RedBad" Color="{StaticResource C_RedBad}" />
    <SolidColorBrush x:Key="CyanInfo" Color="{StaticResource C_CyanInfo}" />
    <SolidColorBrush x:Key="Fg" Color="{StaticResource C_Fg}" />
    <SolidColorBrush x:Key="FgMid" Color="{StaticResource C_FgMid}" />
    <SolidColorBrush x:Key="FgLow" Color="{StaticResource C_FgLow}" />
    <SolidColorBrush x:Key="UnreadBadge" Color="{StaticResource C_UnreadBadge}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource C_Ink}" />

</ResourceDictionary>
