<Window x:Class="WwanMessenger.App.NewChannelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New channel" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        UseLayoutRounding="True"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        ShowInTaskbar="False">

    <StackPanel Margin="26,22,26,20">

        <TextBlock Text="OPEN CHANNEL" FontFamily="{StaticResource MonoFont}" FontSize="11"
                   FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
        <TextBlock Text="Destination number (E.164 with country code works best, e.g. +447700900123)"
                   Foreground="{StaticResource FgMid}" FontSize="11.5" Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <Rectangle Height="1" Fill="{StaticResource Line}" Opacity="0.7" Margin="0,16,0,14" />

        <TextBlock Text="NUMBER" Style="{StaticResource MonoTag}"
                   Foreground="{StaticResource FgLow}" Margin="0,0,0,6" />
        <TextBox x:Name="NumberInput" Style="{StaticResource TxtCompose}" AcceptsReturn="False"
                 Height="38" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,14"
                 KeyDown="OnNumberKeyDown" />

        <TextBlock Text="LABEL (OPTIONAL)" Style="{StaticResource MonoTag}"
                   Foreground="{StaticResource FgLow}" Margin="0,0,0,6" />
        <TextBox x:Name="NameInput" Style="{StaticResource TxtCompose}" AcceptsReturn="False"
                 Height="38" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,2">
            <Button Style="{StaticResource BtnGhost}" Content="CANCEL" Width="94" Height="34"
                    IsCancel="True" />
            <Button Style="{StaticResource BtnAccent}" Content="OPEN »" Width="94" Height="34"
                    Margin="10,0,0,0" IsDefault="True" Click="OnOpen" />
        </StackPanel>
    </StackPanel>
</Window>
