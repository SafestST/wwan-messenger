<Window x:Class="WwanMessenger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WWAN MESSENGER"
        Width="1280" Height="800" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        Closing="OnClosing"
        StateChanged="OnStateChanged">

    <!-- Custom chrome: no system caption, custom min/max/close; resize borders,
         snap and taskbar behaviour preserved by WindowChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="8"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ===== local decoration keys (NOT part of the frozen theme contract) =====
             Palette-agnostic overlays so they harmonize with any graphite theme. -->
        <LinearGradientBrush x:Key="LwSheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#16FFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="LwTopHi" Color="#1EFFFFFF" />

        <DropShadowEffect x:Key="LwDockShadow" Color="#64748B" BlurRadius="20"
                          ShadowDepth="4" Direction="270" Opacity="0.14" />

        <!-- signal meter bar: shared base, active fill = contract GreenOk -->
        <Style x:Key="LwSigBar" TargetType="Rectangle">
            <Setter Property="Width" Value="4" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Fill" Value="{DynamicResource GreenOk}" />
        </Style>

        <!-- transcript row: no selection/hover chrome, stretch to viewport -->
        <Style x:Key="LwMsgItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- console log line: no selection chrome -->
        <Style x:Key="LwLogItem" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ================= HERO / HEADER ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RailBg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- raised-surface sheen + 1px top highlight -->
                <Rectangle Grid.RowSpan="2" Fill="{StaticResource LwSheen}" IsHitTestVisible="False" />
                <Rectangle Grid.RowSpan="2" Height="1" VerticalAlignment="Top"
                           Fill="{StaticResource LwTopHi}" IsHitTestVisible="False" />

                <!-- row 1: TITLE BAR — brand (drag region) | console + window buttons -->
                <Grid Grid.Row="0" Margin="14,8,8,6" Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- open-source keyhole mark -->
                        <Viewbox Width="21" Height="21" Margin="4,0,10,0" VerticalAlignment="Center">
                            <Canvas Width="22" Height="22">
                                <Ellipse Canvas.Left="1.4" Canvas.Top="1.4" Width="19.2" Height="19.2"
                                         Stroke="{DynamicResource GreenOk}" StrokeThickness="1.9" Fill="Transparent" />
                                <Ellipse Canvas.Left="8.7" Canvas.Top="6.4" Width="4.6" Height="4.6"
                                         Fill="{DynamicResource GreenOk}" />
                                <Path Data="M 8.2,10.6 L 13.8,10.6 L 15.1,17.4 L 6.9,17.4 Z"
                                      Fill="{DynamicResource GreenOk}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="WWAN MESSENGER" Style="{StaticResource BrandTitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- theme cycle: swaps the palette dictionary at runtime -->
                        <Button Style="{StaticResource BtnGhost}" Width="34" Padding="0,6" Margin="0,0,8,0"
                                Command="{Binding Path=CycleThemeCommand}" ToolTipService.ShowDuration="6000">
                            <Button.ToolTip>
                                <TextBlock Text="{Binding Path=ThemeName, StringFormat='Theme: {0} (click to cycle)'}" />
                            </Button.ToolTip>
                            <!-- palette glyph: plate + three theme dots -->
                            <Canvas Width="15" Height="15">
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="13" Height="13"
                                         Stroke="{DynamicResource FgMid}" StrokeThickness="1.2" Fill="Transparent" />
                                <Ellipse Canvas.Left="4.1" Canvas.Top="4.7" Width="2.6" Height="2.6"
                                         Fill="{DynamicResource Accent}" />
                                <Ellipse Canvas.Left="8.3" Canvas.Top="3.3" Width="2.6" Height="2.6"
                                         Fill="{DynamicResource GreenOk}" />
                                <Ellipse Canvas.Left="8.1" Canvas.Top="8.7" Width="2.6" Height="2.6"
                                         Fill="{DynamicResource CyanInfo}" />
                            </Canvas>
                        </Button>
                        <Button Style="{StaticResource BtnGhost}" Width="104" Margin="0,0,10,0"
                                Command="{Binding Path=ToggleConsoleCommand}" Content="CONSOLE »" />
                        <Button Style="{StaticResource WinBtn}" Click="OnMinimizeClick" ToolTip="Minimize">
                            <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource FgMid}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="MaxRestoreBtn" Style="{StaticResource WinBtn}" Click="OnToggleMaximizeClick"
                                ToolTip="Maximize / restore">
                            <Path x:Name="MaxGlyph" Data="M 0.7,0.7 L 0.7,8.3 L 8.3,8.3 L 8.3,0.7 Z"
                                  Stroke="{DynamicResource FgMid}" StrokeThickness="1.4" Fill="Transparent" />
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}" Click="OnCloseClick" ToolTip="Close">
                            <Grid>
                                <Path x:Name="glyph" Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource FgMid}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="1" />
                                <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#FFFFFFFF"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="0" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- row 2: instrument strip — lamps, operator, signal -->
                <StackPanel Grid.Row="1">
                    <Rectangle Height="1" Fill="{DynamicResource Line}" Opacity="0.55" />
                    <Grid Margin="18,7,18,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- LINK lamp pill -->
                            <Border CornerRadius="11" Background="{DynamicResource PanelBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    Padding="10,0,12,0" Height="24" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="13" Height="13" Margin="0,0,7,0">
                                        <Ellipse Width="13" Height="13" Fill="{Binding Path=LinkBrush}" Opacity="0.25" />
                                        <Ellipse Width="6" Height="6" Fill="{Binding Path=LinkBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Path=LinkLabel}" Style="{StaticResource MonoTag}" />
                                </StackPanel>
                            </Border>

                            <!-- SIM lamp pill -->
                            <Border CornerRadius="11" Background="{DynamicResource PanelBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    Padding="10,0,12,0" Height="24" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="13" Height="13" Margin="0,0,7,0">
                                        <Ellipse Width="13" Height="13" Fill="{Binding Path=SimBrush}" Opacity="0.25" />
                                        <Ellipse Width="6" Height="6" Fill="{Binding Path=SimBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Path=SimLabel}" Style="{StaticResource MonoTag}" />
                                </StackPanel>
                            </Border>

                            <!-- NET lamp pill -->
                            <Border CornerRadius="11" Background="{DynamicResource PanelBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    Padding="10,0,12,0" Height="24" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="13" Height="13" Margin="0,0,7,0">
                                        <Ellipse Width="13" Height="13" Fill="{Binding Path=NetBrush}" Opacity="0.25" />
                                        <Ellipse Width="6" Height="6" Fill="{Binding Path=NetBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Path=NetLabel}" Style="{StaticResource MonoTag}" />
                                </StackPanel>
                            </Border>

                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Line}"
                                       Opacity="0.6" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding Path=OperatorReadout}" Style="{StaticResource MonoTag}"
                                       Foreground="{DynamicResource Fg}" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <!-- live radio technology (LTE / HSPA+ / roaming) -->
                            <Border CornerRadius="9" Background="{DynamicResource PanelBg}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    Padding="9,0,10,0" Height="20" Margin="0,0,14,0"
                                    Visibility="{Binding Path=RadioReadout, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="{Binding Path=RadioReadout}" Style="{StaticResource MonoTag}"
                                           Foreground="{DynamicResource GreenOk}" FontWeight="SemiBold" />
                            </Border>

                            <!-- signal meter: 5 rounded bars, 6â†’18px, SignalBars 0—5 -->
                            <StackPanel Orientation="Horizontal" Height="18" VerticalAlignment="Center">
                                <Rectangle Height="6" Margin="0,0,3,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle" BasedOn="{StaticResource LwSigBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="0">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="9" Margin="0,0,3,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle" BasedOn="{StaticResource LwSigBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="0">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="1">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="12" Margin="0,0,3,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle" BasedOn="{StaticResource LwSigBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="0">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="1">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="2">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="15" Margin="0,0,3,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle" BasedOn="{StaticResource LwSigBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="0">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="1">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="2">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="3">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Height="18">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle" BasedOn="{StaticResource LwSigBar}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="0">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="1">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="2">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="3">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Path=SignalBars}" Value="4">
                                                    <Setter Property="Fill" Value="{DynamicResource Line}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </StackPanel>

                            <TextBlock Text="{Binding Path=RssiReadout}" Style="{StaticResource MonoTag}"
                                       Margin="9,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= BODY ================= -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="316" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ========== channel rail ========== -->
            <Border Grid.Column="0" Background="{DynamicResource RailBg}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,14,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CHANNELS" Style="{StaticResource MonoTag}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="+ NEW"
                                Padding="10,4" Click="OnNewChannel" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Path=Conversations}"
                             SelectedItem="{Binding Path=SelectedConversation}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ChannelItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                            Background="{DynamicResource PanelBg}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            Margin="0,0,11,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Path=Initials}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Path=Title}" Foreground="{DynamicResource Fg}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path=LastPreview}" Foreground="{DynamicResource FgLow}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Right">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Click="OnTogglePin" ToolTip="Pin / unpin channel"
                                                    Cursor="Hand" Focusable="False" Background="Transparent"
                                                    BorderThickness="0" Padding="3,1" Margin="0,0,4,0"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Path Data="M 6,0 C 3.8,0 2,1.8 2,4 C 2,6.2 6,10 6,10 C 6,10 10,6.2 10,4 C 10,1.8 8.2,0 6,0 Z M 6,12.6 L 6,17"
                                                      StrokeThickness="0">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="{DynamicResource FgLow}" />
                                                            <Setter Property="Opacity" Value="0.45" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Path=IsPinned}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Path=LastTime}"
                                                       Style="{StaticResource MonoTag}"
                                                       Foreground="{DynamicResource FgLow}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Visibility="{Binding Path=HasUnread, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource UnreadBadge}" CornerRadius="9"
                                                Padding="7,2" MinWidth="24" Margin="0,6,0,0"
                                                HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Path=UnreadCount}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource Bg}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ========== transcript ========== -->
            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- transcript header -->
                <Border x:Name="TranscriptHeader" Grid.Row="0" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,0,0,1" Padding="20,12,20,11"
                        Visibility="{Binding Path=HasConversation, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=SelectedConversation.Title}" FontSize="17"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                                       VerticalAlignment="Center" />
                            <!-- pencil affordance: reveals on header hover, renames the contact -->
                            <Button x:Name="RenameBtn" Click="OnRenameContact" ToolTip="Rename"
                                    Width="24" Height="24" Margin="9,0,0,0" VerticalAlignment="Center"
                                    Cursor="Hand" Focusable="False" Background="Transparent"
                                    BorderThickness="0" Padding="2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Width="14" Height="14" Stretch="None" Fill="Transparent"
                                      Data="M 2.2,12.2 L 2.9,9.4 L 10.2,2.1 L 11.9,3.8 L 5.0,10.7 Z M 11.1,1.2 L 12.8,2.9"
                                      StrokeThickness="1.3" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{DynamicResource FgMid}" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=TranscriptHeader, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Opacity" Value="0.75" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=RenameBtn, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource Line}"
                                       Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Path=SelectedConversation.Number}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{DynamicResource FgMid}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="9" Background="{DynamicResource PanelBg}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=StatusLine}" Style="{StaticResource MonoTag}"
                                       Foreground="{DynamicResource CyanInfo}"
                                       MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>

                <!-- messages + empty state -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="Transcript" ItemsSource="{Binding Path=SelectedConversation.Messages}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{StaticResource LwMsgItem}"
                             Padding="16,14,16,16">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- inbound card (left) -->
                                    <Border Grid.Column="0" Background="{DynamicResource CardIn}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            CornerRadius="14,14,14,4" Padding="14,9,14,10" Margin="0,0,10,0"
                                            HorizontalAlignment="Left" MaxWidth="560"
                                            Visibility="{Binding Path=IsIncoming, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path=Text}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Fg}" FontSize="13.5" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                                <TextBlock Text="{Binding Path=TimeDisplay}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource FgLow}" />
                                                <TextBlock Text="{Binding Path=StatusWord}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{Binding Path=StatusBrush}" Margin="9,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- outbound card (right): amber surface + 3px accent base -->
                                    <Border Grid.Column="1" Background="{DynamicResource CardOut}"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,3"
                                            CornerRadius="14,14,4,14" Padding="14,9,14,10" Margin="10,0,0,0"
                                            HorizontalAlignment="Right" MaxWidth="560"
                                            Visibility="{Binding Path=IsIncoming, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path=Text}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Fg}" FontSize="13.5" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                                <TextBlock Text="{Binding Path=TimeDisplay}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{DynamicResource FgLow}" />
                                                <TextBlock Text="{Binding Path=StatusWord}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                                           Foreground="{Binding Path=StatusBrush}" Margin="9,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- no-channel empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Path=HasConversation, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="NO CHANNEL SELECTED" Style="{StaticResource MonoTag}"
                                   FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Text="USE + NEW TO OPEN A CHANNEL" Style="{StaticResource MonoTag}"
                                   HorizontalAlignment="Center" Margin="0,7,0,0" Opacity="0.7" />
                    </StackPanel>
                </Grid>

                <!-- compose dock -->
                <Border Grid.Row="2" Background="{DynamicResource RailBg}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                        Padding="18,12,18,14" Effect="{StaticResource LwDockShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- destination readout -->
                        <StackPanel Grid.Column="0" Width="160" Margin="0,2,18,0" VerticalAlignment="Top"
                                    Visibility="{Binding Path=HasConversation, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="TO" Style="{StaticResource MonoTag}"
                                       Foreground="{DynamicResource FgLow}" />
                            <TextBlock Text="{Binding Path=SelectedConversation.Number}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{DynamicResource FgMid}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBox Style="{StaticResource TxtCompose}" Height="66"
                                     Text="{Binding Path=ComposeText, UpdateSourceTrigger=PropertyChanged}"
                                     x:Name="ComposeInput" PreviewKeyDown="OnComposeKeyDown"
                                     IsEnabled="{Binding Path=Connected}" />
                            <Grid Margin="2,6,2,0">
                                <TextBlock Text="ENTER TO SEND · SHIFT+ENTER FOR NEWLINE"
                                           Style="{StaticResource MonoTag}" FontSize="9.5"
                                           Foreground="{DynamicResource FgLow}" Opacity="0.85" />
                                <TextBlock Text="{Binding Path=SegmentCounter}"
                                           Style="{StaticResource MonoTag}" FontSize="9.5"
                                           Foreground="{DynamicResource FgLow}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource BtnAccent}" Content="SEND »"
                                Width="112" Height="66" Margin="14,0,0,0" VerticalAlignment="Top"
                                Command="{Binding Path=SendCommand}" ToolTip="Send message (Enter)" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== console drawer ========== -->
            <Border Grid.Column="2" Width="368"
                    Visibility="{Binding Path=ConsoleOpen, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource RailBg}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- connection controls (power users) — end users never need this -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,10,14,11">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Style="{StaticResource MonoTag}"
                                       FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Style="{StaticResource CmbDark}" Width="168"
                                          ItemsSource="{Binding Path=Ports}"
                                          SelectedItem="{Binding Path=SelectedPort}"
                                          ToolTip="Transport: MBIM modem, simulator, or a serial AT port" />
                                <Button Style="{StaticResource BtnGhost}" Content="SCAN" Width="52"
                                        Margin="6,0,6,0" Padding="0,6"
                                        Command="{Binding Path=RefreshPortsCommand}"
                                        ToolTip="Rescan transports (does not disconnect)" />
                                <Button Style="{StaticResource BtnAccent}" Width="88" Padding="0,6"
                                        Command="{Binding Path=ConnectCommand}"
                                        Content="{Binding Path=ConnectButtonLabel}"
                                        ToolTip="Bring the channel up / retry" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid DockPanel.Dock="Top" Margin="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MODEM CONSOLE" Style="{StaticResource MonoTag}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="9" Height="9">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource GreenOk}"
                                         Visibility="{Binding Path=Connected, Converter={StaticResource BoolToVis}}" />
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource FgLow}"
                                         Visibility="{Binding Path=Connected, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                            <TextBlock Text="LIVE" Style="{StaticResource MonoTag}" Margin="6,0,0,0"
                                       Visibility="{Binding Path=Connected, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="IDLE" Style="{StaticResource MonoTag}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource FgLow}"
                                       Visibility="{Binding Path=Connected, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Line}" Opacity="0.6" />
                    <ListView x:Name="ConsoleView" ItemsSource="{Binding Path=ConsoleLines}"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemContainerStyle="{StaticResource LwLogItem}"
                              Padding="8,6,8,10"
                              FontFamily="{StaticResource MonoFont}" FontSize="10.5">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=Text}" Foreground="{Binding Path=Brush}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           TextWrapping="NoWrap" Margin="2,1" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
